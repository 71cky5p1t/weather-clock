# Cloudflare tunnel connector token (not the tunnel UUID)
CF_TUNNEL_TOKEN=replace_with_cloudflare_connector_token

# Public host routed by Traefik
TSV_RADAR_HOST=indigo.onlybbm.com

# Saltbox Traefik docker network (usually traefik_proxy)
TRAEFIK_DOCKER_NETWORK=traefik_proxy

# Weather location (Open-Meteo, no API key needed)
LOCATION_NAME=TOWNSVILLE
LAT=-19.26
LON=146.82

# Optional: if set, dashboard writes (message, playlist save, refresh buttons)
# must send this token. Leave blank on a trusted LAN.
ADMIN_TOKEN=

# Auto-deploy from GitHub (deployer sidecar). Where the repo is cloned on the
# server, and the secret you paste into the GitHub webhook settings.
REPO_DIR=/opt/weather-clock
GITHUB_WEBHOOK_SECRET=change-me-long-random-string

# Optional: auto-fetch pixel-art GIFs for the GIF page (free key from developers.giphy.com).
# Without it the GIF page only plays files you drop into content/gifs/.
GIPHY_API_KEY=
GIPHY_QUERIES=pixel art,8bit,retro game,pixel loop

# Wikimedia Commons auto-fetch for the GIF page (no key, free licences). Set to 0 to disable.
COMMONS_GIFS=1
